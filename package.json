{
  "name": "natillera-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/write-test-env.mjs && node scripts/bootstrap-test.mjs && playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "ux:baseline": "node scripts/ux-02b-baseline.mjs",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:env:write": "node scripts/write-dev-env.mjs",
    "dev:demo": "tsx scripts/dev-demo.ts",
    "dev:open": "node scripts/open-local-app.mjs",
    "dev:infra:start": "supabase start",
    "dev:infra:stop": "supabase stop",
    "dev:db:migrate": "supabase migration up --local",
    "dev:bootstrap": "tsx scripts/bootstrap-workspace.ts",
    "test:infra:start": "node scripts/test-supabase.mjs start && node scripts/write-test-env.mjs",
    "test:infra:reset": "node scripts/test-supabase.mjs reset && node scripts/write-test-env.mjs",
    "test:infra:stop": "node scripts/test-supabase.mjs stop",
    "test:rls": "node scripts/test-supabase.mjs rls",
    "block-d:fixture": "tsx scripts/block-d-trial.ts fixture",
    "block-d:dry-run": "tsx scripts/block-d-trial.ts dry-run",
    "block-d:stage": "tsx scripts/block-d-trial.ts stage",
    "block-d:publish-trial": "tsx scripts/block-d-trial.ts publish-trial",
    "block-d:export": "tsx scripts/block-d-trial.ts export",
    "block-d:restore-check": "tsx scripts/block-d-trial.ts restore-check",
    "legacy:import-2026": "tsx scripts/import-legacy-2026.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "@vitejs/plugin-react": "^5.1.2",
    "decimal.js": "^10.6.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "jsdom": "^27.3.0",
    "supabase": "^2.116.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
